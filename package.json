    "@fastify/static": "^8.1.1",
    "dotenv": "^17.4.2",
    "exifr": "^7.1.3",
    "fastify": "^5.2.1",
    "heic-convert": "^2.1.0",
    "pg": "^8.14.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.5.0",
    "sharp": "^0.34.1",
    "styled-components": "^6.1.17",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/heic-convert": "^2",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.11.11",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.3",
