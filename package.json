  "private": true,
  "type": "module",
  "packageManager": "yarn@4.9.2",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch src/presentation/app/index.ts",
    "build": "vite build && vite build --ssr src/frontend/entry-server.tsx --outDir dist/ssr && tsc -p tsconfig.server.json",
